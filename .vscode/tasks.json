{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "web: dev server",
      "type": "shell",
      "command": "npm run web:dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^x^" },
        "background": {
          "activesBegin": ".",
          "beginsPattern": "VITE v",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "api: MyVedicStar shared host (http://localhost:5289)",
      "type": "shell",
      "command": "dotnet run --project ../myvedicstar/src/MyVedicStar.API --launch-profile shared",
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet",
        "pattern": { "regexp": "^x^" },
        "background": {
          "activesBegin": ".",
          "beginsPattern": "Building|info:",
          "endsPattern": "Now listening on|Application started"
        }
      }
    },
    {
      "label": "web + api",
      "dependsOn": ["api: MyVedicStar shared host (http://localhost:5289)", "web: dev server"]
    },
    {
      "label": "mobile: Android emulator (native debug build)",
      "type": "shell",
      "command": "npx expo run:android",
      "options": {
        "cwd": "${workspaceFolder}/apps/mobile",
        "env": { "EXPO_PUBLIC_API_BASE_URL": "http://10.0.2.2:5289/api/v1" }
      },
      "problemMatcher": []
    },
    {
      "label": "mobile: expo start",
      "type": "shell",
      "command": "npm run mobile:start",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
