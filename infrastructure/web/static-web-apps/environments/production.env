# Production — web deployment target and runtime configuration (/config.json).
#
# Loaded by scripts/deploy.sh (--env-file). A non-empty environment variable of the same name — e.g. a GitHub
# repository/environment variable — overrides the value here, so settings can change without a commit.
#
# EVERY VALUE HERE IS PUBLIC (the MVS_* values are served to browsers). Never add secrets: no client secrets, API keys,
# storage keys, SAS tokens or deployment tokens. Unknown MVS_* names are rejected by the deployment.
# Source of these values: myvedicstar-infra Terraform (prod + external-id outputs).

# --- Deployment target (not sent to browsers) ---
# Static Web App managed by Terraform (myvedicstar-infra, module "static_web_app") in the hub subscription.
AZURE_STATIC_WEB_APP_SUBSCRIPTION_ID=aff891ac-8cfd-4e93-b3b9-4059458d4ea4
AZURE_RESOURCE_GROUP=rg-myvedicstar-prod-edge-eus2
AZURE_STATIC_WEB_APP_NAME=stapp-myvedicstar-prod

# --- Runtime configuration ---
MVS_ENVIRONMENT=production
MVS_SITE_URL=https://www.myvedicstar.com

# Backend through API Management.
#   MyVedicDay (Panchang) API  → /myvedicday     → backend routes /api/v1/...
#   MyVedicStar (Authorize) API → /myvedicstar    → backend routes /api/v1/auth/... (overridden below)
MVS_API_BASE_URL=https://apim-myvedicstar-prod-xw4t.azure-api.net
MVS_API_ENDPOINT_PREFIX=/myvedicday/api/v1
MVS_API_ENDPOINTS='{"authUserInfo":"/myvedicstar/api/v1/auth/userinfo"}'

# Sign-in: Microsoft Entra External ID (myvedicstarexternal), SPA public client with PKCE — no client secret.
MVS_AUTH_MODE=entra-external-id
MVS_AUTH_AUTHORITY=https://myvedicstarexternal.ciamlogin.com/
MVS_AUTH_TENANT_ID=cbece845-e124-4de7-89d3-96a71abb7b83
MVS_AUTH_CLIENT_ID=828e1ce9-0393-406b-909d-d088b92d06dc
MVS_AUTH_API_CLIENT_ID=1a3384a0-8857-4854-8d96-3f94c1b1c18e
MVS_AUTH_PROVIDERS=email

# Feature flags to enable (comma separated). None are read by the web app yet.
MVS_FEATURE_FLAGS=

# Browser telemetry → appi-myvedicstar-prod (shared with the backend). The connection string is public by design.
MVS_TELEMETRY_ENABLED=true
MVS_TELEMETRY_SAMPLE_RATE=1
MVS_APPINSIGHTS_CONNECTION_STRING="InstrumentationKey=ba6f6c94-080e-4e52-91c9-40da2ed049d5;IngestionEndpoint=https://eastus2-3.in.applicationinsights.azure.com/;LiveEndpoint=https://eastus2.livediagnostics.monitor.azure.com/;ApplicationId=0407c0a2-01d3-4340-8fd7-73ca3bd466f1"
