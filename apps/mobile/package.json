{
  "name": "@myvedicstar/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "My Vedic Star for Android and iOS (React Native + Expo). Released independently of the web SPA.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@myvedicstar/query-cache": "0.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@expo/vector-icons": "15.1.1",
    "@myvedicstar/analytics": "0.1.0",
    "@myvedicstar/api-client": "0.1.0",
    "@myvedicstar/config": "0.1.0",
    "@myvedicstar/contracts": "0.1.0",
    "@myvedicstar/date-time": "0.1.0",
    "@myvedicstar/design-tokens": "0.1.0",
    "@myvedicstar/domain-models": "0.1.0",
    "@myvedicstar/localization": "0.1.0",
    "@myvedicstar/validation": "0.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.104.0",
    "expo": "57.0.33",
    "expo-auth-session": "57.0.13",
    "expo-constants": "57.0.19",
    "expo-crypto": "57.0.3",
    "expo-linking": "57.0.11",
    "expo-localization": "57.0.2",
    "expo-location": "57.0.20",
    "expo-router": "57.0.23",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "expo-web-browser": "57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@myvedicstar/testing": "0.1.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "test-renderer": "1.3.0"
  },
  "jest": {
    "preset": "jest-expo",
    "maxWorkers": 2,
    "testTimeout": 15000,
    "testMatch": [
      "<rootDir>/src/**/*.test.{ts,tsx}",
      "<rootDir>/app/**/*.test.{ts,tsx}"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|standard-navigation|@myvedicstar/.*)"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
