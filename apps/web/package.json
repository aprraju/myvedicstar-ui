{
  "name": "@myvedicstar/web",
  "version": "0.1.0",
  "private": true,
  "description": "My Vedic Star web SPA (React + Vite). Deploys as static files; no Node.js runtime.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode local",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@myvedicstar/analytics": "0.1.0",
    "@myvedicstar/api-client": "0.1.0",
    "@myvedicstar/config": "0.1.0",
    "@myvedicstar/contracts": "0.1.0",
    "@myvedicstar/date-time": "0.1.0",
    "@myvedicstar/design-tokens": "0.1.0",
    "@myvedicstar/domain-models": "0.1.0",
    "@myvedicstar/localization": "0.1.0",
    "@myvedicstar/validation": "0.1.0",
    "@tanstack/react-query": "5.104.0",
    "oidc-client-ts": "3.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.89.0",
    "react-router": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@myvedicstar/testing": "0.1.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "29.1.1",
    "msw": "3.0.0"
  }
}
